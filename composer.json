{
    "name": "egbavou/benin-business-id",
    "description": "Offline Beninese IFU and RCCM validation with optional APIEx directory checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/egbavou/benin-business-id",
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.8 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.24",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/translation": "^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel integration (^12.0 or ^13.0).",
        "guzzlehttp/guzzle": "PSR-18 client automatically used by the Laravel integration (^7.8)."
    },
    "autoload": {
        "psr-4": {
            "Egbavou\\BeninBusinessId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Egbavou\\BeninBusinessId\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Egbavou\\BeninBusinessId\\Laravel\\BeninBusinessIdServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "test:live": "pest --configuration=phpunit.live.xml --group=live"
    },
    "keywords": [
        "benin",
        "ifu",
        "rccm",
        "ohada",
        "apiex",
        "validation",
        "laravel",
        "business-id"
    ],
    "authors": [
        {
            "name": "Egbavou"
        }
    ],
    "support": {
        "issues": "https://github.com/egbavou/benin-business-id/issues",
        "source": "https://github.com/egbavou/benin-business-id"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/egbavou"
        }
    ]
}
